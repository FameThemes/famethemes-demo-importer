{
	"name": "famethemes-demo-importer",
	"version": "1.3.0",
	"private": true,
	"description": "Build pipeline for the Generic track's React UI. OnePress track stays on its legacy jQuery / Underscore assets — it is not part of this build.",
	"scripts": {
		"start": "wp-scripts start --webpack-src-dir=src/generic --output-path=inc/generic/build",
		"build": "wp-scripts build --webpack-src-dir=src/generic --output-path=inc/generic/build",
		"format": "wp-scripts format src/",
		"lint:js": "wp-scripts lint-js src/"
	},
	"devDependencies": {
		"@wordpress/browserslist-config": "^6.48.0",
		"@wordpress/scripts": "^30"
	},
	"dependencies": {
		"@wordpress/icons": "^13.1.0"
	}
}
